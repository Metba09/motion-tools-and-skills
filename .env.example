# Copier en .env (ignoré par git). Aucun secret n'est requis pour le mode hors-ligne du sandbox.
# 1 = hors-ligne (défaut) : scripts réseau refusés (code 3), mocks actifs. 0 = mainteneur avec Internet.
MOTION_OFFLINE=1
# Chemin d'un Chrome/Chromium ; vide = détection automatique (scripts/chrome.sh).
CHROME_PATH=
# Mock Fal.ai dans starters/dioramas (1 = assets factices). Réel : FAL_MOCK=0 + MOTION_OFFLINE=0 + FAL_KEY.
FAL_MOCK=1
FAL_KEY=
# Services désactivés hors-ligne (ne remplir qu'avec MOTION_OFFLINE=0).
ELEVENLABS_API_KEY=
HF_TOKEN=
