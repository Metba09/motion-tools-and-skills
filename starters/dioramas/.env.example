# Copier en .env pour régler le projet. Aucune clé n'est nécessaire en mode hors-ligne (mock Fal).
#
# MOTION_OFFLINE=1  (défaut) : aucune requête réseau ; scripts/fal.mjs répond avec ./scripts/fal-mock.mjs
# MOTION_OFFLINE=0           : réseau autorisé -> génération réelle, il faut alors FAL_KEY
MOTION_OFFLINE=1
# FAL_MOCK=1 force le mock même en ligne ; FAL_MOCK=0 le désactive (avec MOTION_OFFLINE=0)
#FAL_MOCK=1
# Clé fal.ai (https://fal.ai/dashboard/keys) — uniquement si MOTION_OFFLINE=0
#FAL_KEY=
# Navigateur de rendu : renseigné automatiquement par scripts/env.sh (CHROME_PATH). Surcharge possible :
#DIORAMA_CHROME=/usr/bin/google-chrome
